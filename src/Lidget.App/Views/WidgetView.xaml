<UserControl x:Class="Lidget.App.Views.WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lidget.App.Views"
             xmlns:vm="clr-namespace:Lidget.App.ViewModels"
             xmlns:fmt="clr-namespace:Lidget.Core.Formatting;assembly=Lidget.Core"
             d:DataContext="{d:DesignInstance vm:UsageViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="12"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <views:PercentToStarConverter x:Key="PercentToStar" />

        <Style x:Key="SeverityFill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Taskbar.Severity.Normal}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WidgetSeverity}" Value="{x:Static fmt:UsageSeverity.Warning}">
                    <Setter Property="Background" Value="{DynamicResource Taskbar.Severity.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WidgetSeverity}" Value="{x:Static fmt:UsageSeverity.Critical}">
                    <Setter Property="Background" Value="{DynamicResource Taskbar.Severity.Critical}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasData}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Taskbar.Muted}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderIcon" TargetType="Path">
            <Setter Property="Fill" Value="{Binding IconBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconBrush}" Value="{x:Null}">
                    <Setter Property="Fill" Value="{DynamicResource Taskbar.Foreground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusGlyph" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetSurface" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Taskbar.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" />
            <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <MenuItem Header="Quit Lidget" Command="{Binding QuitCommand}" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border x:Name="Surface"
            Style="{StaticResource WidgetSurface}"
            CornerRadius="4"
            Margin="0,4"
            Padding="4,0"
            MouseLeftButtonUp="OnSurfaceClicked">
        <Grid VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding VisibleProviders}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProviderViewModel">
                        <StackPanel Orientation="Horizontal" Margin="4,0" Background="Transparent"
                                    ToolTip="{Binding WidgetTooltip}" ToolTipService.InitialShowDelay="400">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Path Data="{Binding Icon}" Stretch="Uniform" Style="{StaticResource ProviderIcon}" />
                                <TextBlock Text="!" Style="{StaticResource StatusGlyph}"
                                           FontWeight="Bold" FontSize="10" Margin="0,0,-5,-4"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource Taskbar.Severity.Warning}" />
                            </Grid>
                            <Grid Width="26" Height="4" Margin="7,0,6,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding WidgetPercent, Converter={StaticResource PercentToStar}}" />
                                    <ColumnDefinition Width="{Binding WidgetPercent, Converter={StaticResource PercentToStar}, ConverterParameter=rest}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource Taskbar.Track}" />
                                <Border Grid.Column="0" CornerRadius="2" Style="{StaticResource SeverityFill}" />
                            </Grid>
                            <TextBlock Text="{Binding WidgetText}" MinWidth="26" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Taskbar.Foreground}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="EmptyText" Text="Lidget" Margin="4,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Taskbar.Foreground}" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
