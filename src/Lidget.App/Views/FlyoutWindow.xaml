<ui:FluentWindow x:Class="Lidget.App.Views.FlyoutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Lidget.App.Views"
                 xmlns:vm="clr-namespace:Lidget.App.ViewModels"
                 xmlns:fmt="clr-namespace:Lidget.Core.Formatting;assembly=Lidget.Core"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:UsageViewModel}"
                 Title="Lidget"
                 Width="360"
                 MinWidth="0"
                 MinHeight="0"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 UseLayoutRounding="True">
    <Window.Resources>
        <views:PercentToStarConverter x:Key="PercentToStar" />
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SeverityFill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static fmt:UsageSeverity.Warning}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static fmt:UsageSeverity.Critical}">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProviderIcon" TargetType="Path">
            <Setter Property="Fill" Value="{Binding IconBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IconBrush}" Value="{x:Null}">
                    <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="PaceCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunsOutBeforeReset}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CostTile" TargetType="Border">
            <Setter Property="Padding" Value="10,6,10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="CostValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <DataTemplate x:Key="LimitTemplate" DataType="vm:LimitViewModel">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
                <Grid Grid.Row="1" Height="12" Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding BarPercent, Converter={StaticResource PercentToStar}}" />
                        <ColumnDefinition Width="{Binding BarPercent, Converter={StaticResource PercentToStar}, ConverterParameter=rest}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Height="6" CornerRadius="3" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                    <Border Height="6" CornerRadius="3" Style="{StaticResource SeverityFill}" />
                    <!-- The even-pace marker. The outer margins let its center reach both ends of the bar. -->
                    <Grid Grid.ColumnSpan="2" Margin="-1,0" Visibility="{Binding HasPace, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding PacePercent, Converter={StaticResource PercentToStar}}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{Binding PacePercent, Converter={StaticResource PercentToStar}, ConverterParameter=rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Width="2" CornerRadius="1" Background="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,1,0,0">
                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding PaceText}" Style="{StaticResource PaceCaption}" />
                    <TextBlock Text="{Binding ResetText}" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ProviderTemplate" DataType="vm:ProviderViewModel">
            <Border Margin="0,0,0,8" Padding="14,12,14,14" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Path DockPanel.Dock="Left" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                              Data="{Binding Icon}" Style="{StaticResource ProviderIcon}" />
                        <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Border DockPanel.Dock="Left" Margin="8,0,0,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Visibility="{Binding PlanName, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding PlanName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding UpdatedText}" Style="{StaticResource Caption}" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource LimitTemplate}" Focusable="False" />

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding HasCosts, Converter={StaticResource BoolToVisibility}}">
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource CostTile}" Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Today" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding CostToday}" Style="{StaticResource CostValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CostTile}" Margin="2,0">
                                <StackPanel>
                                    <TextBlock Text="7 days" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Cost7Days}" Style="{StaticResource CostValue}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CostTile}" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="30 days" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Cost30Days}" Style="{StaticResource CostValue}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Margin="0,6,0,0" Text="{Binding CostNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="4"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning16" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="14,14,14,10">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="2,0,0,12" Text="AI usage limits" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleProviders}" ItemTemplate="{StaticResource ProviderTemplate}" Focusable="False" />

        <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="2,0,0,12" TextWrapping="Wrap" Style="{StaticResource Caption}"
                   Text="No providers are on. Open Settings to choose which limits to show." Visibility="Collapsed" />

        <!-- The code-behind adds the chart only while the flyout is open. See FlyoutWindow.AttachHistory. -->
        <Border x:Name="HistorySlot" Grid.Row="2" Margin="0,0,0,8"
                Visibility="{Binding History, Converter={StaticResource NullToCollapsed}}" />

        <DockPanel Grid.Row="3" Margin="0,2,0,0" LastChildFill="False">
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="8" Margin="4,0,0,0"
                       Icon="{ui:SymbolIcon Settings20}" ToolTip="Settings" AutomationProperties.Name="Settings" Command="{Binding OpenSettingsCommand}" />
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="8"
                       Icon="{ui:SymbolIcon ArrowSync20}" ToolTip="Refresh now" AutomationProperties.Name="Refresh now" Command="{Binding RefreshCommand}" />
            <ui:ProgressRing DockPanel.Dock="Right" Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True"
                             Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
