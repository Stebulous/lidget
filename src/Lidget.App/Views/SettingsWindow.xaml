<ui:FluentWindow x:Class="Lidget.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Lidget.App.ViewModels"
                 xmlns:views="clr-namespace:Lidget.App.Views"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
                 Title="Lidget settings"
                 Width="560"
                 Height="720"
                 MinWidth="480"
                 MinHeight="400"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,20,0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Lidget settings" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Providers" Style="{StaticResource SectionHeader}" Margin="4,4,0,8" />
                <ui:CardControl Header="Claude" Icon="{ui:SymbolIcon Sparkle20}">
                    <ui:CardControl.Content>
                        <ui:ToggleSwitch AutomationProperties.Name="Claude" IsChecked="{Binding ClaudeEnabled}" />
                    </ui:CardControl.Content>
                </ui:CardControl>
                <ui:CardControl Header="Codex" Icon="{ui:SymbolIcon Code20}">
                    <ui:CardControl.Content>
                        <ui:ToggleSwitch AutomationProperties.Name="Codex" IsChecked="{Binding CodexEnabled}" />
                    </ui:CardControl.Content>
                </ui:CardControl>

                <TextBlock Text="Display" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Gauge20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Show limits as" />
                            <TextBlock Text="Applies to the widget, the flyout, the history chart, and notifications." TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox AutomationProperties.Name="Show limits as" MinWidth="200" ItemsSource="{Binding DisplayOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedDisplay}" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon DataBarHorizontal20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Percentage in the taskbar" />
                            <TextBlock Text="Tightest shows the limit closest to running out." TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox AutomationProperties.Name="Percentage in the taskbar" MinWidth="200" ItemsSource="{Binding MetricOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedMetric}" />
                </ui:CardControl>
                <ui:CardControl Header="Distance from the system tray" Icon="{ui:SymbolIcon ArrowAutofitWidth20}">
                    <ui:NumberBox AutomationProperties.Name="Distance from the system tray" Width="140" Minimum="0" Maximum="400" SmallChange="2" LargeChange="20" MaxDecimalPlaces="0"
                                  Value="{Binding WidgetTrayOffset, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>

                <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon ArrowSync20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Refresh interval" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding RefreshIntervalMinutes, StringFormat='Every {0:0} minutes'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Slider AutomationProperties.Name="Refresh interval in minutes" Width="200" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding RefreshIntervalMinutes}" />
                </ui:CardControl>

                <TextBlock Text="Notifications" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon Alert20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Warn when usage passes these percentages" />
                            <TextBlock Text="Separate values with commas, for example 80, 95." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:TextBox AutomationProperties.Name="Warn when usage passes these percentages" Width="140" Text="{Binding ThresholdsText, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                </ui:CardControl>
                <TextBlock Text="{Binding ThresholdsError}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding ThresholdsError, Converter={StaticResource NullToCollapsed}}" />
                <ui:CardControl Header="Notify when a limit resets" Icon="{ui:SymbolIcon ArrowReset20}">
                    <ui:ToggleSwitch AutomationProperties.Name="Notify when a limit resets" IsChecked="{Binding NotifyOnReset}" />
                </ui:CardControl>

                <TextBlock Text="Claude readings while you work" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Icon="{ui:SymbolIcon WindowConsole20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Read limits from the Claude Code statusline" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Lidget wraps your statusline command and keeps its output. Claude Code hides most footer key hints when a statusline is set. Project statusline settings override this one." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch AutomationProperties.Name="Claude Code statusline feed" IsChecked="{Binding ClaudeStatusLineFeed}" />
                </ui:CardControl>
                <TextBlock Text="{Binding StatusLineError}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding StatusLineError, Converter={StaticResource NullToCollapsed}}" />
                <ui:CardControl Icon="{ui:SymbolIcon Chat20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Read limits from T3 Code" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="T3 Code logs the Claude limits after each response. Lidget reads only those entries. Claude Code does not run the statusline in T3 Code." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch AutomationProperties.Name="Read limits from T3 Code" IsChecked="{Binding ClaudeT3CodeFeed}" />
                </ui:CardControl>

                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                <ui:CardControl Header="Start with Windows" Icon="{ui:SymbolIcon Power20}">
                    <ui:ToggleSwitch AutomationProperties.Name="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                </ui:CardControl>
                <ui:CardControl Icon="{ui:SymbolIcon History20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Keep usage history" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding HistoryRetentionDays, StringFormat='{}{0:0} days'}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:NumberBox AutomationProperties.Name="Days of usage history to keep" Width="140" Minimum="1" Maximum="3650" SmallChange="1" LargeChange="30" MaxDecimalPlaces="0"
                                  Value="{Binding HistoryRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                </ui:CardControl>
                <ui:CardAction Icon="{ui:SymbolIcon Folder20}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Open data folder" />
                        <TextBlock Text="{Binding DataDirectory}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardAction>

                <TextBlock Margin="4,16,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding Version, StringFormat='Lidget {0}'}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
